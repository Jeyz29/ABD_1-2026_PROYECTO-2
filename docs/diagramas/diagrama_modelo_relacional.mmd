    PERSONA {
        INT id_persona PK
        VARCHAR nombre
        VARCHAR apellidos
        VARCHAR correo UK
        DATE fecha_incorporacion
        VARCHAR tipo_persona
        VARCHAR estatus
    }

    VENDEDOR {
        INT id_vendedor PK,FK
        DECIMAL cuota_ventas
    }

    SUPERVISOR {
        INT id_supervisor PK,FK
        VARCHAR zona
        INT id_supervisor_jefe FK
    }

    PERSONAL_FINANZAS {
        INT id_personal PK,FK
        VARCHAR cargo
    }

    SUPERVISOR_VENDEDOR {
        INT id_asignacion_sup PK
        INT id_supervisor FK
        INT id_vendedor FK
        DECIMAL porcentaje_reconocimiento
        DATE fecha_inicio
        DATE fecha_fin
    }

    CLIENTE {
        INT id_cliente PK
        VARCHAR codigo_cliente UK
        VARCHAR nombre
        VARCHAR segmento_mercado
    }

    PRODUCTO {
        INT id_producto PK
        VARCHAR codigo_producto UK
        VARCHAR nombre
        VARCHAR categoria
        DECIMAL precio
        DECIMAL costo_unitario
    }

    FACTURA {
        INT id_factura PK
        VARCHAR numero_factura UK
        INT id_cliente FK
        DATE fecha_emision
        VARCHAR situacion
        DATE fecha_cobro
    }

    FACTURA_DETALLE {
        INT id_factura PK,FK
        INT id_producto PK,FK
        DECIMAL cantidad
        DECIMAL monto
        VARCHAR motivo
    }

    ROL_VENTA {
        INT id_rol PK
        VARCHAR nombre_rol UK
        VARCHAR descripcion
    }

    FACTURA_PARTICIPACION {
        INT id_participacion PK
        INT id_factura FK
        INT id_vendedor FK
        INT id_rol FK
        DECIMAL porcentaje_participacion
    }

    PLAN_COMISION {
        INT id_plan PK
        VARCHAR codigo_plan UK
        VARCHAR nombre
        DECIMAL tasa_comision
        VARCHAR base_aplicacion
        BIT admite_descuento
    }

    ASIGNACION_PLAN {
        INT id_asignacion_plan PK
        INT id_vendedor FK
        INT id_rol FK
        INT id_plan FK
        DATE fecha_inicio_vigor
        DATE fecha_fin_vigor
    }

    PLAN_FILTRO {
        INT id_plan PK,FK
        INT numero_orden PK
        VARCHAR tipo_filtro
        VARCHAR valor_filtro
    }

    PERIODO {
        INT id_periodo PK
        VARCHAR codigo_periodo UK
        VARCHAR descripcion
        VARCHAR tipo_periodo
        DATE fecha_inicio
        DATE fecha_fin
    }

    CALCULO_COMISION {
        INT id_calculo PK
        INT id_periodo FK
        INT id_persona FK
        DECIMAL monto_propio_ventas
        DECIMAL monto_supervision
        DECIMAL monto_total_reconocido
        VARCHAR estado_reconocimiento
    }

    CALCULO_DETALLE {
        INT id_calculo_detalle PK
        INT id_calculo FK
        INT id_factura FK
        INT id_rol FK
        DECIMAL base_comisionable
        DECIMAL tasa_aplicada
        DECIMAL comision_generada
        VARCHAR tipo_origen
    }

    PAGO_COMISION {
        INT id_pago PK
        INT id_periodo_pago FK
        INT id_persona FK
        DATE fecha_pago
        DECIMAL monto
        VARCHAR estado_pago
        INT id_personal_finanzas FK
    }
